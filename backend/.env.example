CFS_ENV=development
CFS_DATABASE_PATH=../database/cfs.db
DATABASE_URL=
CFS_STORAGE_BACKEND=local
CFS_S3_ENDPOINT_URL=
CFS_S3_REGION=auto
CFS_S3_BUCKET=
CFS_S3_ACCESS_KEY_ID=
CFS_S3_SECRET_ACCESS_KEY=
CFS_S3_PUBLIC_BASE_URL=
CFS_OWNER_BOOTSTRAP_TOKEN=replace-me
CFS_ANTIVIRUS_REQUIRED=false
CFS_PAYMENTS_MODE=MOCK
CFS_PRODUCTION_PAYMENTS_ENABLED=false
# SHARED_MARKER keeps the existing shared-wallet unique-decimal binding.
# EXCLUSIVE is for exact prices and must be paired with per-order receive-address allocation.
CFS_DEPOSIT_ADDRESS_MODE=SHARED_MARKER
CFS_TRON_USDT_ADDRESS=
CFS_BSC_USDT_ADDRESS=
CFS_SOL_ADDRESS=
# Optional comma-separated receive-only address pools. Never put private keys here.
CFS_TRON_DEPOSIT_ADDRESSES=
CFS_BSC_DEPOSIT_ADDRESSES=
CFS_SOL_DEPOSIT_ADDRESSES=
CFS_MOCK_SOL_USD_RATE=150.00
CFS_ALLOWED_ORIGINS=http://localhost:8000
